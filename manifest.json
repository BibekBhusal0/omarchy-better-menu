{
  "schemaVersion": 1,
  "id": "bibek.menu",
  "name": "Better Menu",
  "version": "1.0.1",
  "author": "Bibek Bhusal",
  "description": "Omarchy menu with subsequence fuzzy ranking, app grid, calculator and customizable web search.",
